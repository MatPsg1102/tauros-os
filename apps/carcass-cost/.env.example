# Carcass Cost — Supabase Auth e persistência (P-0001). Copie para apps/carcass-cost/.env
# (ignorado pelo Git) e preencha com os valores do projeto Supabase compartilhado do Tauros OS.
# ATENÇÃO: nunca coloque valores reais neste arquivo (ele é commitado).
# Sem estas variáveis o app funciona como hoje (calculadora e histórico local), sem conta.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
