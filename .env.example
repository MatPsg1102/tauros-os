# --- Supabase CLOUD (crie o projeto em supabase.com e copie daqui) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon public key (RLS é a fronteira)

# Dashboard → Project Settings → API (NUNCA no cliente; só admin/seeds)
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Connect → ORMs (connection string com a senha do banco)
# Use a porta 5432 (direta) para migrations.
DATABASE_URL=                        # postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_ENV=development
