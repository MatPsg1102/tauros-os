// Identidade & tenant — Store, Profile, Employee, StoreMembership.
// `store_id` é coluna de tenant sem relação Prisma (FK/RLS no Supabase).

model Store {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  cnpj            String?   @unique
  timezone        String?
  shiftAnchorDate DateTime? @map("shift_anchor_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stores")
}

/// Espelho de auth.users (id = auth user id). Global, sem store_id.
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employees   Employee[]
  memberships StoreMembership[]

  @@map("profiles")
}

/// Registro de RH da pessoa, escopado por loja.
model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  profileId    String?  @map("profile_id") @db.Uuid
  jobTitleId   String?  @map("job_title_id") @db.Uuid
  registration String
  fullName     String   @map("full_name")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile     Profile?             @relation(fields: [profileId], references: [id])
  jobTitle    JobTitle?            @relation(fields: [jobTitleId], references: [id])
  membership  StoreMembership?
  assignments EmployeeAssignment[]

  @@unique([storeId, registration])
  @@index([storeId])
  @@map("employees")
}

/// Vínculo ativo profile↔loja — base da autorização efetiva (ADR-018).
model StoreMembership {
  id         String           @id @default(uuid()) @db.Uuid
  storeId    String           @map("store_id") @db.Uuid
  profileId  String           @map("profile_id") @db.Uuid
  employeeId String?          @unique @map("employee_id") @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  startedAt  DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?        @map("ended_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile          Profile                        @relation(fields: [profileId], references: [id])
  employee         Employee?                      @relation(fields: [employeeId], references: [id])
  roles            MembershipRole[]
  overrides        MembershipPermissionOverride[]
  operatorSessions OperatorSession[]

  @@index([storeId])
  @@index([profileId])
  @@map("store_memberships")
}
