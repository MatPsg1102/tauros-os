{
  "name": "tauros-os",
  "private": true,
  "version": "0.0.0",
  "description": "Tauros OS — PWA operacional de gestão de açougue (monorepo). Implementação regida pela SAS v1.3 e artefatos congelados do Design System.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "type": "module",
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "knip": "knip",
    "changeset": "changeset",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:apply-sql": "node tooling/apply-sql.mjs",
    "db:seed": "node tooling/apply-sql.mjs --seeds-only",
    "check:hardcoded": "node tooling/check-hardcoded-styles.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "knip": "^5.39.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23 <9",
      "vite": ">=6.4.3",
      "uuid": ">=11.1.1",
      "next": ">=15.5.21 <16",
      "sharp": ">=0.35.0 <0.36",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4 <3",
      "brace-expansion@5": ">=5.0.9 <6",
      "fast-uri": ">=3.1.5 <4",
      "js-yaml@3": ">=3.15.1 <4",
      "js-yaml@4": ">=4.3.1 <5",
      "nanoid@3": ">=3.3.17 <4"
    }
  }
}
